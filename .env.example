# Telegram
BOT_TOKEN=123456:telegram-bot-token
ADMIN_IDS=123456789

# H1 panel API. Use the exact API address shown in Panel -> API access.
# For a bot hosted outside Russia, use direct-<node>.h1cloud.net:<port> if required.
PANEL_API_URL=https://direct-your-panel.h1cloud.net:PORT
PANEL_API_TOKEN=your-panel-api-token

# Map each selectable location to its connected H1 node id and LOCAL inbound ids.
# The same customer UUID is used for all selected nodes.
PANEL_LOCATIONS_JSON={"🇩🇪 Германия":{"node_id":"NODE_ID_DE","inbound_ids":["INBOUND_DE"],"channels":["main","reality"]},"🇳🇱 Нидерланды":{"node_id":"NODE_ID_NL","inbound_ids":["INBOUND_NL"],"channels":["main","reality"]},"🇵🇱 Польша":{"node_id":"NODE_ID_PL","inbound_ids":["INBOUND_PL"],"channels":["main","reality"]},"🇫🇮 Финляндия":{"node_id":"NODE_ID_FI","inbound_ids":["INBOUND_FI"],"channels":["main","reality"]},"🇺🇸 США":{"node_id":"NODE_ID_US","inbound_ids":["INBOUND_US"],"channels":["main","reality"]},"🇯🇵 Япония":{"node_id":"NODE_ID_JP","inbound_ids":["INBOUND_JP"],"channels":["main","reality"]},"🌐 Обход белых списков":{"node_id":"NODE_ID_BS","inbound_ids":["INBOUND_BS"],"channels":["main","reality","bs"]}}

# Platega merchant credentials (both are required by the official API)
PLATEGA_MERCHANT_ID=00000000-0000-0000-0000-000000000000
PLATEGA_SECRET=your-platega-api-secret
PLATEGA_API_URL=https://app.platega.io
PLATEGA_PAYMENT_METHOD=2
CURRENCY=RUB

# Platega status is checked by the bot over its outbound API connection.
# No public domain, callback URL, or inbound HTTP port is required.
PAYMENT_POLL_INTERVAL=20

# Optional
DB_PATH=data/awesomevpn.sqlite3
TRAFFIC_LIMIT_GB=0
PANEL_CHANNELS=main,reality
LOG_LEVEL=INFO
